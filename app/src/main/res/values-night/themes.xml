<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark variant: only status-bar icon polarity differs; M3 surface/outline
         roles are inherited from Theme.Material3.DayNight's night values. -->
    <style name="Theme.IDR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/idr_primary</item>
        <item name="colorOnPrimary">@color/idr_on_primary</item>
        <item name="colorPrimaryDark">@color/idr_primary_dark</item>
        <item name="colorSecondary">@color/idr_navic</item>
        <item name="colorOnSecondary">@color/idr_on_primary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

</resources>
