<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Material 3 (Material You) base theme. Migrated from Theme.MaterialComponents
      (M2) so the M3 component styles and ?attr/colorSurfaceContainer* /
      ?attr/textAppearance* tokens resolve — see .claude/skills/idr-android-ui §3.
      Surface / outline / error roles are inherited from Theme.Material3.DayNight
      (correct in both light and dark); only the brand colours are overridden.
    -->
    <style name="Theme.IDR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/idr_primary</item>
        <item name="colorOnPrimary">@color/idr_on_primary</item>
        <item name="colorPrimaryDark">@color/idr_primary_dark</item>
        <item name="colorSecondary">@color/idr_navic</item>
        <item name="colorOnSecondary">@color/idr_on_primary</item>

        <!-- Edge-to-edge: bars are transparent, MainActivity insets the chrome. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- No hardcoded windowBackground: Theme.Material3.DayNight supplies a
             day/night-correct one. A fixed white here flashed on dark-mode launch. -->
    </style>

    <!-- Bottom action sheet: rounded top corners only. -->
    <style name="ShapeAppearance.Idr.ActionBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/action_bar_corner</item>
        <item name="cornerSizeTopRight">@dimen/action_bar_corner</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
